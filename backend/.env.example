# Copy to .env and fill in what you have. The gateway runs fully in
# MOCK MODE for any provider whose key is left blank -- great for demoing
# the routing engine without live API costs.

DATABASE_URL=sqlite:///./gateway.db
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=dev-secret-change-me

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

GEMMA_BASE_URL=http://localhost:11434/v1
GEMMA_MODEL_NAME=gemma2:2b

# Provider timeouts (seconds) — tune per provider
PROVIDER_TIMEOUT_OLLAMA=15
PROVIDER_TIMEOUT_OPENAI=45
PROVIDER_TIMEOUT_ANTHROPIC=60
PROVIDER_TIMEOUT_GOOGLE=45
PROVIDER_MAX_RETRIES=2
